            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: #f8fafc;
            color: #1e293b;
            padding-bottom: 95px;
        }

        .header {
            background: linear-gradient(180deg, #07111e 0%, #0f233d 100%);
            text-align: center;
            padding: 35px 20px 25px;
            border-bottom: 3px solid #d4af37;
        }

        .header h1 {
            color: #d4af37;
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .header p {
            color: #cbd5e1;
            font-size: 15px;
            font-weight: 600;
        }

        .container {
            max-width: 500px;
            margin: 0 auto;
            padding: 20px 15px;
        }

        .card {
            background: #ffffff;
            border: 2px solid #d4af37;
            border-radius: 18px;
            padding: 20px 16px;
            margin-bottom: 22px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
            text-align: center;
        }

        .card-title {
            color: #b8860b;
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .card-text {
            color: #334155;
            font-size: 16px;
            line-height: 1.8;
            font-weight: 600;
        }

        .cert-img {
            width: 100%;
            border-radius: 12px;
            border: 1px solid #0f233d;
            display: block;
        }

        .services-container {
            background: #ffffff;
            border: 2px solid #d4af37;
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 22px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        }

        .service-item {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .service-item:last-child {
            margin-bottom: 0;
        }

        .service-text {
            color: #0f172a;
            font-size: 15px;
            font-weight: 700;
        }

        .service-check {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 16px;
            font-weight: bold;
            color: #475569;
        }

        .service-check .dash {
            color: #10b981;
            font-weight: 900;
        }

        .gallery-img {
            width: 100%;
            border-radius: 14px;
            margin-bottom: 14px;
            border: 1px solid #e2e8f0;
            display: block;
        }

        .gallery-img:last-child {
            margin-bottom: 0;
        }

        .bottom-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #ffffff;
            padding: 12px 16px;
            display: flex;
            gap: 12px;
            box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
            z-index: 1000;
            max-width: 500px;
            margin: 0 auto;
        }

        .btn {
            flex: 1;
            padding: 14px 0;
            border-radius: 35px;
            font-size: 18px;
            font-weight: 800;
            text-decoration: none;
            text-align: center;
            color: #ffffff;
            display: block;
        }

        .btn-call {
            background-color: #0077b6;
        }

        .btn-whatsapp {
